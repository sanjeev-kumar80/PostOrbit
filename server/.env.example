PORT=5001
CLIENT_URL=https://localhost:5173
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret
# Required only while creating the first admin account. Keep this private.
ADMIN_SETUP_KEY=replace-with-a-long-random-secret

# Local HTTPS development URLs. Register BUFFER_REDIRECT_URI in the Buffer App Client.
LOCAL_HTTPS=true
BUFFER_CLIENT_ID=your-buffer-oauth-client-id
# BUFFER_CLIENT_SECRET=your-confidential-client-secret
BUFFER_REDIRECT_URI=https://localhost:5001/api/social-accounts/buffer/callback

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SOCIAL_TOKEN_ENCRYPTION_KEY=64-character-hex-key

# Optional: enables backend AI caption and hashtag generation.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional: required for uploading local image/video files to a public media URL
# so Buffer can fetch and publish the media.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Generate the local certificate used by the backend and Vite dev server:
# mkdir -p server/.cert
# openssl req -x509 -newkey rsa:2048 -sha256 -days 365 -nodes -keyout server/.cert/localhost-key.pem -out server/.cert/localhost-cert.pem -subj '/CN=localhost' -addext 'subjectAltName=DNS:localhost,IP:127.0.0.1'
